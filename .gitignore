# Game files and anything derived from them must never be committed.
# All of it can be regenerated from your own copy of the game.
/Nier/
/recomp/out/
/recomp/ppc/
/recomp/shaders/
/recomp/frames/

# Generated by tools/make_config.ps1
/recomp/config/nier.toml
/recomp/config/nier_switch_tables.toml
/recomp/config/nier_functions.snippet.toml
/recomp/runtime/stubs.gen.cpp

# Player data
/save/

# Build output and logs
/recomp/build/
/recomp/build_cover/
/tools/build/
*.log
*.log.err

# Safety net in case game data lands somewhere unexpected
*.xex
*.xexp
*.cpk
*.sfd
*.iso
*.ppm
/recomp/captures/
/recomp/shadercache/
/save_backups/
/recomp/test_save/
/recomp/test_settings.ini
/recomp/replay_settings.ini
/recomp/build/settings.ini
/dlc/
/tools/SDL3/
/tools/FidelityFX/
/tools/Streamline/

# Recorded controller input for test runs (run_boot.ps1 -Record)
/recomp/recordings/

# Every pipeline the game has used on this machine (input of tools/pipeline_list)
/recomp/pipelines_seen.txt
__pycache__/

# Zipped test builds (tools: see README in the zip)
/dist/
/benchmark/
/benchmark_results.txt
/recomp/benchmark_results.txt
/recomp/benchmark_save/
/recomp/benchmark_settings.ini
/recomp/benchmark.log
/recomp/benchmark.log.err
